<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Number_of_victims</fullName>
    <active>false</active>
    <errorConditionFormula>$Profile.Name &lt;&gt; &apos;System Administrator&apos; &amp;&amp; 
