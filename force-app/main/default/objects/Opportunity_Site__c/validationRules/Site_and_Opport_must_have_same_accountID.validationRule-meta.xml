<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Site_and_Opport_must_have_same_accountID</fullName>
    <active>false</active>
    <errorConditionFormula>Opportunity__r.Account.Id &lt;&gt; Site__r.Account__r.Id</errorConditionFormula>
    <errorMessage>Site and Opportunity must have the same Account</errorMessage>
</ValidationRule>
