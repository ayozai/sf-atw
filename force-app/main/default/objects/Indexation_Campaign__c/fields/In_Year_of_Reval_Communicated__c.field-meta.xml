<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>In_Year_of_Reval_Communicated__c</fullName>
    <formula>IF(
  NOT(ISBLANK(Indexation_Effective_Date__c)),

  (12 - MONTH(Indexation_Effective_Date__c) + 1) / 12,

  IF(
    NOT(ISBLANK(Reval_Effective_Date_Communicated__c)),

    (12 - MONTH(Reval_Effective_Date_Communicated__c) + 1) / 12,

    (12 - MONTH(Revaluation_Effective_Date_Targeted__c) + 1) / 12
  )
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>In Year % of Reval (Communicated)</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Percent</type>
</CustomField>
