<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Total_Months_Active__c</fullName>
    <description>How many months are represented by the start and end (optional) of this record?</description>
    <externalId>false</externalId>
    <formula>IF(ISBLANK(End_Date__c), ((YEAR(TODAY()) - YEAR(Start_Date__c))*12) + (MONTH(TODAY()) - MONTH(Start_Date__c)), ((YEAR(End_Date__c) - YEAR(Start_Date__c))*12) + (MONTH(End_Date__c) - MONTH(Start_Date__c))) + 1</formula>
    <inlineHelpText>How many months are represented by the start and end (optional) of this record?</inlineHelpText>
    <label>Total Months Active</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
