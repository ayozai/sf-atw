<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <alerts>
        <fullName>Update_Support_Requester_of_Approval_Change</fullName>
        <ccEmails>solutions@servest.co.uk</ccEmails>
        <description>Update Support Requester of Approval Change</description>
        <protected>false</protected>
        <recipients>
            <type>creator</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>unfiled$public/Bid_Support_Request_Approval</template>
    </alerts>
    <rules>
        <fullName>Email Owner on Approval Change</fullName>
        <actions>
            <name>Update_Support_Requester_of_Approval_Change</name>
            <type>Alert</type>
        </actions>
        <active>true</active>
        <description>Send an email to the Bid Support Request Owner when the Approval status changes</description>
        <failedMigrationToolVersion>236.18.3</failedMigrationToolVersion>
        <formula>IsChanged(Approval__c)</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
</Workflow>
