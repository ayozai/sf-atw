        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>close_date_to_today</fullName>
        <description>Set the close date on opportunity to today</description>
        <field>CloseDate</field>
        <formula>Today()</formula>
        <name>close date to today</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Formula</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <rules>
        <fullName>Global_Stage_Closed_Lost_Snapshot</fullName>
        <actions>
            <name>Global_Stage_Closed_Lost_Snapshot</name>
            <type>FieldUpdate</type>
        </actions>
        <active>false</active>
        <criteriaItems>
            <field>Opportunity.StageName</field>
            <operation>equals</operation>
            <value>6. Closed Lost</value>
        </criteriaItems>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>Is Opportunity Cloned%3F</fullName>
        <actions>
            <name>Update_Is_Clone</name>
            <type>FieldUpdate</type>
        </actions>
        <active>false</active>
        <formula>ISCLONE()</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>set closedate</fullName>
        <actions>
            <name>close_date_to_today</name>
            <type>FieldUpdate</type>
        </actions>
        <active>false</active>
        <description>for all closed opportunity set the closed date to date closed</description>
        <formula>AND(
ISCHANGED(StageName),
IsClosed = TRUE,
CloseDate &lt;&gt; TODAY ())</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
</Workflow>
