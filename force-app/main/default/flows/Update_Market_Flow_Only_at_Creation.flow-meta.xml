    <formulas>
        <name>CreatedDateWeekday</name>
        <dataType>Number</dataType>
        <expression>MOD( DATEVALUE({!$Record.CreatedDate})- DATE(1900, 1, 7), 7)+1</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>CreatedDateWeekNumber</name>
        <dataType>Number</dataType>
        <expression>FLOOR((DATEVALUE({!$Record.CreatedDate})- DATE( {!CreatedDateWeekYear},1,1) +
MOD(
(MOD( DATE({!CreatedDateWeekYear},1,1) - DATE(1900, 1, 7), 7)+1)
+1,7)-3) / 7 + 1)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>CreatedDateWeekString</name>
        <dataType>String</dataType>
        <expression>TEXT({!CreatedDateWeekYear}) + &quot;-&quot; + IF({!CreatedDateWeekNumber}&lt;10,&quot;0&quot;,&quot;&quot;) + TEXT({!CreatedDateWeekNumber})</expression>
    </formulas>
    <formulas>
        <name>CreatedDateWeekYear</name>
        <dataType>Number</dataType>
        <expression>YEAR(DATEVALUE({!$Record.CreatedDate})+ (MOD(8- {!CreatedDateWeekday} ,7)-3))</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>CreatedWeekNumberOLD</name>
        <dataType>Number</dataType>
        <expression>FLOOR((DATEVALUE({!$Record.CreatedDate}) - DATE( YEAR(DATEVALUE({!$Record.CreatedDate})),1,1) + MOD(DATE(YEAR(DATEVALUE({!$Record.CreatedDate})),1,1) - DATE(1900, 1, 7), 7))/7+1)</expression>
        <scale>2</scale>
    </formulas>
