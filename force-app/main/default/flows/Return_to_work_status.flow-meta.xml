            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Return_to_work_status_outdated</name>
        <label>Set Return-to-work status outdated</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Return_to_work_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Outdated</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_return_to_work_to_do</name>
        <label>Set return-to-work to do</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Return_to_work_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>To do</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Outdated</name>
        <label>Outdated</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>return_to_work_status_is_null</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Outdated</name>
            <conditionLogic>(1 AND 3 AND 4) OR (4 AND 3 AND 2)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Return_to_work_Status__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Return_to_work_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>To do</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Number_of_lost_work_day__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Incident_Date_Plus</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>$Flow.CurrentDate</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Return_to_work_status_outdated</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>return_to_work_needs_to_be_done</name>
        <label>return-to-work needs to be done</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_return_to_work_not_applicable</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Copy_1_of_Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Number_of_lost_work_day__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>15.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Workplace incident</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_return_to_work_to_do</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>return_to_work_status_is_null</name>
        <label>return-to-work status is null</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Return_to_work_Status__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>return_to_work_needs_to_be_done</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>Incident_Date_Plus</name>
        <dataType>Date</dataType>
        <expression>{!$Record.Incident_Date__c} + {!$Record.Number_of_lost_work_day__c} + 180</expression>
    </formulas>
    <interviewLabel>Return-to-work status {!$Flow.CurrentDateTime}</interviewLabel>
