<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>All_Siblings_Closed</name>
        <label>All Siblings Closed?</label>
        <locationX>264</locationX>
        <locationY>278</locationY>
        <defaultConnectorLabel>Has Open Siblings — Stop</defaultConnectorLabel>
        <rules>
            <name>No_Open_Siblings</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Open_Siblings</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Won_Siblings</targetReference>
            </connector>
            <label>No Open Siblings</label>
        </rules>
    </decisions>
    <decisions>
        <name>No_Won_Siblings</name>
        <label>No Won Siblings?</label>
        <locationX>484</locationX>
        <locationY>398</locationY>
        <defaultConnectorLabel>Some Were Won — Stop</defaultConnectorLabel>
        <rules>
            <name>All_Lost</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Won_Siblings</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Close_Framework_Contract</targetReference>
            </connector>
            <label>All Lost</label>
        </rules>
    </decisions>
    <description>When a requalified opportunity is closed lost/withdrawn, checks if all sibling requalification opportunities (same origin) are also closed. If none remain open and none were won, marks the linked framework contract as Ended.</description>
    <interviewLabel>Opportunity RTF Requalification Close Contract {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity RTF Requalification Close Contract</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Open_Siblings</name>
        <label>Get Open Sibling Opportunities</label>
        <locationX>264</locationX>
        <locationY>158</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>All_Siblings_Closed</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Contract_Custom__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Contract_Custom__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsClosed</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Is_Requalification_Opp__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Opportunity</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Won_Siblings</name>
        <label>Get Won Sibling Opportunities</label>
        <locationX>484</locationX>
        <locationY>278</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>No_Won_Siblings</targetReference>
