<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>51.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>Check the split value of the opportunity owner. if the value is greater than 0 then the Indirect Performance field on the Team Member record needs to be set to 0. If the split value is 0 then the Indirect Performance field should be 100</description>
        <name>Check_Split_Value</name>
        <label>Check Split Value</label>
        <locationX>314</locationX>
        <locationY>1127</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_Greater_Than_0</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.SplitPercentage</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Indirect_Performance_to_0</targetReference>
            </connector>
            <label>Is Greater Than 0</label>
        </rules>
        <rules>
            <name>Is_Equal_To_0</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.SplitPercentage</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Indirect_Performance_to_100</targetReference>
            </connector>
            <label>Is Equal To 0</label>
        </rules>
    </decisions>
    <decisions>
        <name>No_split_found</name>
        <label>No split found</label>
        <locationX>534</locationX>
        <locationY>695</locationY>
        <defaultConnector>
            <targetReference>Loop_on_all_the_splits</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_member_split</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Indirect_Performance_to_100_0</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>If an Opportunity Team Member has a split value of greater than 0 then set their Indirect Performance value to 0, otherwise set to 100</description>
    <interviewLabel>Set Opportunity Team Member Indirect Performance {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Set Opportunity Team Member Indirect Performance</label>
    <loops>
