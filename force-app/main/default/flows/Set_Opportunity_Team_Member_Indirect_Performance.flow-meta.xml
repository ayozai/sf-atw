        <locationX>314</locationX>
        <locationY>455</locationY>
        <collectionReference>Get_all_members_of_the_opportunity</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Get_member_split</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Check_Split_Value</targetReference>
        </noMoreValuesConnector>
    </loops>
