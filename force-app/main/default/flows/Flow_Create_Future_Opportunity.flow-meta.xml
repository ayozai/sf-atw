    <formulas>
        <name>vActivityDescription</name>
        <dataType>String</dataType>
        <expression>IF(
TEXT({!vOpportunity.User_Creator_Country__c}) &lt;&gt;&apos;FR&apos;,
&apos;This task has been created as part of the future opportunity process. Please review and update the information for this future opportunity by the due date of this task. Pay particular attention to the timeline information. &apos;,
&apos;Cette tâche a été créée par le processus de création de la future opportunité.Merci de vérifier et de mettre à jour les informations avant la date échéance.Faites plus particulièrement attention aux champs date.&apos;
)</expression>
    </formulas>
    <formulas>
        <name>vActivityType</name>
        <dataType>String</dataType>
        <expression>If(TEXT({!vOpportunity.User_Creator_Country__c})=&apos;FR&apos;,&apos;Suivi : Mise à jour Opportunité Future&apos;,&apos;Follow up: Future Opportunity Update&apos;)</expression>
    </formulas>
    <formulas>
        <name>vNewAODate</name>
        <dataType>Date</dataType>
        <expression>ADDMONTHS({!vOpportunity.Proposal_ITT_Issue_Date__c},{!vOpportunity.Contract_Duration_Months__c})</expression>
    </formulas>
    <formulas>
        <name>vNewCloseDate</name>
        <dataType>Date</dataType>
        <expression>{!vNewStartDate}-({!vOpportunity.contract_start_date__c}-{!vOpportunity.CloseDate})</expression>
    </formulas>
    <formulas>
        <name>vNewEndDate</name>
        <dataType>Date</dataType>
        <expression>ADDMONTHS({!vOpportunity.Contract_End_Date__c},{!vOpportunity.Contract_Duration_Months__c})</expression>
    </formulas>
    <formulas>
        <name>vNewProcessStartDate</name>
        <dataType>Date</dataType>
        <expression>ADDMONTHS({!vOpportunity.Process_Start_Date__c},{!vOpportunity.Contract_Duration_Months__c})</expression>
    </formulas>
    <formulas>
        <name>vNewStartDate</name>
        <dataType>Date</dataType>
        <expression>{!vOpportunity.Contract_End_Date__c}+1</expression>
    </formulas>
    <formulas>
        <name>vTodayPlus6</name>
        <dataType>Date</dataType>
        <expression>TODAY()+6</expression>
    </formulas>
