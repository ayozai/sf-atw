        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_All_Performances</name>
        <label>Create All Performances</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>varRecordsToCreate</inputReference>
    </recordCreates>
    <recordLookups>
        <name>Get_Employee_Targets_Current_Year</name>
        <label>Get Employee Targets - Current Year</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Performance_This_Month</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Target_date__c</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <elementReference>f_StartOfYear</elementReference>
            </value>
        </filters>
        <filters>
            <field>Target_date__c</field>
            <operator>LessThanOrEqualTo</operator>
            <value>
                <elementReference>f_EndOfYear</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Employee_target__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Performance_This_Month</name>
        <label>Get Performance - This Month</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Build_Keys</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Date__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>f_MonthStart</elementReference>
            </value>
        </filters>
        <object>Employee_performance__c</object>
        <outputReference>varExistingPerfs</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Employee_Target__c</queriedFields>
    </recordLookups>
