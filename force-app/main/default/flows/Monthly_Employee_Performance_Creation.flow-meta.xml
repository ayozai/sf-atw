<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_Key</name>
        <label>Add Key</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varExistingKeys</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>f_KeyForBuild</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Build_Keys</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Build_and_Add_New_Perf</name>
        <label>Build and Add New Perf</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>newPerf.Date__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>f_MonthStart</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>newPerf.Employee_Target__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_on_Employee_Targets.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>newPerf.Employee__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_on_Employee_Targets.Employee__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varRecordsToCreate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>newPerf</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_on_Employee_Targets</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Employee_is_Active</name>
        <label>Employee is Active ?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_on_Employee_Targets</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Employee_is_actif</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_on_Employee_Targets.Employee__r.IsActif__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Performance_Missing</targetReference>
            </connector>
            <label>Yes Employee is actif</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_First_Day_of_Month</name>
        <label>Is First Day of Month ?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>f_IsFirstDayOfMonth</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Employee_Targets_Current_Year</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Performance_Missing</name>
        <label>Performance Missing ?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Build_and_Add_New_Perf</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Already_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varExistingKeys</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>f_KeyForLookup</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_on_Employee_Targets</targetReference>
            </connector>
            <label>Already Exists</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <description>Date correspondant au 31 décembre de l’année en cours, calculée automatiquement à partir de la date d’exécution du flow.
Utilisée pour filtrer les Employee Target de l’année courante.</description>
        <name>f_EndOfYear</name>
        <dataType>Date</dataType>
        <expression>DATE(
  YEAR($Flow.CurrentDate),
  12,
  31
)</expression>
    </formulas>
    <formulas>
        <name>f_IsFirstDayOfMonth</name>
        <dataType>Boolean</dataType>
        <expression>DAY($Flow.CurrentDate) = 1</expression>
    </formulas>
    <formulas>
        <name>f_KeyForBuild</name>
        <dataType>String</dataType>
        <expression>&quot;;&quot; &amp; {!Loop_Build_Keys.Employee_Target__c} &amp; &quot;;&quot;</expression>
    </formulas>
    <formulas>
        <name>f_KeyForLookup</name>
        <dataType>String</dataType>
        <expression>&quot;;&quot; &amp; {!Loop_on_Employee_Targets.Id} &amp; &quot;;&quot;</expression>
    </formulas>
    <formulas>
        <description>Premier jour du mois courant, utilisé pour dater la performance mensuelle.</description>
        <name>f_MonthStart</name>
        <dataType>Date</dataType>
        <expression>DATE(YEAR($Flow.CurrentDate), MONTH($Flow.CurrentDate), 1)</expression>
    </formulas>
    <formulas>
        <description>Date correspondant au 1er janvier de l’année en cours, calculée automatiquement à partir de la date d’exécution du flow.
Utilisée pour filtrer les Employee Target de l’année courante.</description>
        <name>f_StartOfYear</name>
        <dataType>Date</dataType>
        <expression>DATE(
  YEAR($Flow.CurrentDate),
  1,
  1
)</expression>
    </formulas>
    <interviewLabel>Monthly Employee Performance Creation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Monthly Employee Performance Creation</label>
    <loops>
        <name>Loop_Build_Keys</name>
        <label>Loop Build Keys</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>varExistingPerfs</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Add_Key</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Loop_on_Employee_Targets</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>Loop_on_Employee_Targets</name>
        <label>Loop on Employee Targets</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Employee_Targets_Current_Year</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Employee_is_Active</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Create_All_Performances</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
