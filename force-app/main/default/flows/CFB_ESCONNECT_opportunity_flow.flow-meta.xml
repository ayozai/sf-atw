    <description>@Mahdi = changer le BU_CODE + calculatedPublicAccount + calculatedKeyAccount + add fault path when Nace Code Not found + remplacer le risque &quot;Élevé&quot; par &quot;Elevé&quot; + changer la formule de calculatedStatus</description>
    <environments>Default</environments>
    <formulas>
        <name>calculatedGTR</name>
        <dataType>String</dataType>
        <expression>{!GTR_MEDIUM}</expression>
    </formulas>
    <formulas>
        <name>calculatedKeyAccount</name>
        <dataType>Boolean</dataType>
        <expression>ISPICKVAL({!getOpportunity.Account.Account_Governance__c}, &quot;Key Account&quot;)</expression>
    </formulas>
    <formulas>
        <name>calculatedPublicAccount</name>
        <dataType>Boolean</dataType>
        <expression>{!getOpportunity.Account.ESConnect_Public__c}=&apos;PUBLIC&apos;</expression>
    </formulas>
    <formulas>
        <name>calculatedRelationType</name>
        <dataType>String</dataType>
        <expression>&apos;CLIENT&apos;</expression>
    </formulas>
    <formulas>
        <name>calculatedStatus</name>
        <dataType>String</dataType>
        <expression>IF({!getDueDiligence.dueDiligenceMitigations}!=&apos;&apos; &amp;&amp; {!getDueDiligence.dueDiligenceMitigations}!=&apos;0&apos;, CASE({!getDueDiligence.dueDiligenceDecision}, &apos;INPROGRESS&apos;,&apos;IN_PROGRESS&apos;,&apos;CONTINUE&apos;, &apos;ACCEPTED_MIT&apos;, &apos;CONTINUE_UNDER_CONDITION&apos;, &apos;RESTRICTION_MIT&apos;, &apos;STOP&apos;, &apos;REFUSED&apos;,CASE({!getDueDiligence.dueDiligenceStatus}, &apos;INPROGRESS&apos;,&apos;IN_PROGRESS&apos;,&apos;&apos;)), CASE({!getDueDiligence.dueDiligenceDecision}, &apos;INPROGRESS&apos;,&apos;IN_PROGRESS&apos;,&apos;CONTINUE&apos;, &apos;ACCEPTED&apos;, &apos;CONTINUE_UNDER_CONDITION&apos;, &apos;RESTRICTION&apos;, &apos;STOP&apos;, &apos;REFUSED&apos;,CASE({!getDueDiligence.dueDiligenceStatus}, &apos;INPROGRESS&apos;,&apos;IN_PROGRESS&apos;,&apos;&apos;)))</expression>
    </formulas>
    <formulas>
        <description>bases on GTR_VALUE</description>
        <name>GTR_RISK_FORMULA</name>
        <dataType>String</dataType>
        <expression>if ({!GTR_VALUE} &gt;=7,  {!GTR_LOW}, 
if({!GTR_VALUE} &gt;=5, {!GTR_MEDIUM}, {!GTR_HIGH}))</expression>
    </formulas>
    <formulas>
        <name>GTR_VALUE</name>
        <dataType>Number</dataType>
        <expression>{!PUBLIC_COTATION}+{!COUNTRY_COTATION}+{!NACE_CODE_COTATION}</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <description>if (public = 1) else (2)</description>
        <name>PUBLIC_COTATION</name>
        <dataType>Number</dataType>
        <expression>IF({!getOpportunity.Account.ESConnect_Public__c}=&apos;PUBLIC&apos;, 1,2)</expression>
        <scale>0</scale>
    </formulas>
