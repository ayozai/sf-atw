    <decisions>
        <name>Check_Target_Type</name>
        <label>Check Target Type</label>
        <locationX>314</locationX>
        <locationY>134</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsContractual</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>inContractType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Contractual</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>inTargetType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Monthly Target</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Split_line</targetReference>
            </connector>
            <label>IsContractual</label>
        </rules>
        <rules>
            <name>IsNonContractual</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>inContractType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Non Contractual</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>inTargetType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Monthly Target</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Split_line_0</targetReference>
            </connector>
            <label>IsNonContractual</label>
        </rules>
    </decisions>
