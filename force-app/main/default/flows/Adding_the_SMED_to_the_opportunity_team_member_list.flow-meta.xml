<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>49.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>adding_the_user_to_OTML</name>
        <label>adding the user to OTML</label>
        <locationX>759</locationX>
        <locationY>327</locationY>
        <assignmentItems>
            <assignToReference>Teammemberrecord.OpportunityId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>getMyOpp.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Teammemberrecord.OpportunityAccessLevel</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Edit</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Teammemberrecord.UserId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>myUser.user_ID__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Teammemberrecord.TeamMemberRole</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Account Manager</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>adding_to_the_OTM_list</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>adding_to_the_OTM_list</name>
        <label>adding to the OTM list</label>
        <locationX>592</locationX>
        <locationY>337</locationY>
        <assignmentItems>
            <assignToReference>opptml</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Teammemberrecord</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Business_experts_users</targetReference>
        </connector>
    </assignments>
    <interviewLabel>Adding the SMED to the opportunity team member list {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Adding the SMED to the opportunity team member list</label>
    <loops>
        <name>Business_experts_users</name>
        <label>Business experts users</label>
        <locationX>673</locationX>
        <locationY>134</locationY>
        <assignNextValueToReference>myUser</assignNextValueToReference>
        <collectionReference>getMyCustomMetaData</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>adding_the_user_to_OTML</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Add_user_to_the_OTML</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <description>OTML : Opportunity Team Member List( below is the list of France SMED
As of today ( 04/03/2020) :
Catherine BOUCHER is the SMED for the Food industry in the FR region
Healthcare / Santé : Jean-Baptiste LAVAL
Ultra Cleaning / Ultra Propreté : Jean-Baptiste LAVAL
Food Industry / Agroalimentaire : Catherine BOUCHER
Industry : Pierre TRUVELOT
Public access Building / Etablissement recevant du public – ERP : Fernando DE SOUSA
Retail / Retail : Fernando DE SOUSA</description>
        <name>Add_user_to_the_OTML</name>
        <label>Add user to the OTML</label>
        <locationX>1039</locationX>
        <locationY>135</locationY>
        <inputReference>opptml</inputReference>
    </recordCreates>
    <recordLookups>
        <description>We need to get the SMED metaData custom object in order to attribute the appropriate user to the opportunity team member list</description>
        <name>getMyCustomMetaData</name>
        <label>getMyCustomMetaData</label>
        <locationX>455</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Business_experts_users</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Business_Experts__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>getMyOpp.FR_BusinessExperts__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Region__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>getMyOpp.Owner_Country__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>SubjectMaterExpertDirector__mdt</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>user_ID__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>we need to fetch for the converted opportunity. The oppRecordId variable will be passed to the PB that calls the flow</description>
        <name>getMyOpp</name>
        <label>getMyOpp</label>
        <locationX>273</locationX>
        <locationY>136</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>getMyCustomMetaData</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>oppRecordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Opportunity</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Sales_Territory__c</queriedFields>
        <queriedFields>FR_BusinessExperts__c</queriedFields>
        <queriedFields>Division_OLD__c</queriedFields>
        <queriedFields>Owner_Country__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>109</locationX>
        <locationY>135</locationY>
        <connector>
            <targetReference>getMyOpp</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>custom</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>SubjectMaterExpertDirector__mdt</objectType>
    </variables>
    <variables>
