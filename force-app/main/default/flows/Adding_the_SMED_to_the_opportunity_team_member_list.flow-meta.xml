        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>SubjectMaterExpertDirector__mdt</objectType>
    </variables>
    <variables>
        <name>myUsersList</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>SubjectMaterExpertDirector__mdt</objectType>
    </variables>
    <variables>
