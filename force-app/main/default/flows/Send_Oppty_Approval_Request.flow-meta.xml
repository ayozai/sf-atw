        <fields>
            <name>Approvers_Display_Text</name>
            <fieldText>&lt;p&gt;&lt;strong style=&quot;color: rgb(240, 8, 8);&quot;&gt;Merci de choisir vos approbateurs en fonction des seuils de CA Annualisé définis ci-dessous : &lt;/strong&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Thresholds_M_E</name>
            <fieldText>&lt;ul&gt;&lt;li&gt;&lt;strong&gt;&amp;lt; 60k€          : Directeur Régional + Directeur d&apos;agence&lt;/strong&gt;&lt;/li&gt;&lt;li&gt;&lt;strong&gt;60k€ – 300k€    : Directeur Régional + Directeur Commercial Régional&lt;/strong&gt;&lt;/li&gt;&lt;li&gt;&lt;strong&gt;300k€ – 500k€   : Directeur Régional + Directeur Commercial Régional (+ Directeur Opérationnel)&lt;/strong&gt;&lt;/li&gt;&lt;li&gt;&lt;strong&gt;500k€  &lt;/strong&gt;&lt;strong style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;– 1M€&lt;/strong&gt;&lt;strong&gt; : Direction M&amp;amp;E + Directeur Opérationnel&lt;/strong&gt;&lt;/li&gt;&lt;li&gt;&lt;strong style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;≥ 1M€ &lt;/strong&gt;&lt;strong&gt; &lt;/strong&gt;&lt;strong style=&quot;color: rgb(237, 9, 9);&quot;&gt;(ou bien Grands Comptes de +240k€ )&lt;/strong&gt;&lt;strong&gt; : &lt;/strong&gt;&lt;strong style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;Direction M&amp;amp;E + Directeur Opérationnel + Direction Commerciale M&amp;amp;E &lt;/strong&gt;&lt;strong style=&quot;background-color: rgb(255, 255, 255); color: rgb(250, 7, 7);&quot;&gt;(+ Direction GC)&lt;/strong&gt;&lt;/li&gt;&lt;/ul&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>Get_Oppty_Approval_Request.Primary_Service__c</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <stringValue>Technical Services</stringValue>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <fields>
            <name>Thresholds_Cleaning</name>
            <fieldText>&lt;ul&gt;&lt;li&gt;&lt;strong&gt;&amp;lt; 60K€         : Directeur Régional + &lt;/strong&gt;&lt;strong style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;Directeur d&apos;agence&lt;/strong&gt;&lt;/li&gt;&lt;li&gt;&lt;strong&gt;60K → 240K€    : Directeur Régional &lt;/strong&gt;&lt;strong style=&quot;color: rgb(240, 8, 8);&quot;&gt;(Si dossier public ou renouvellement, ajouter le Directeur Commercial Régional en deuxième approbateur)&lt;/strong&gt;&lt;/li&gt;&lt;li&gt;&lt;strong&gt;240K → 600K€   : Directeur Régional + Directeur Commercial Régional&lt;/strong&gt;&lt;/li&gt;&lt;li&gt;&lt;strong&gt;600K → 1M€   : Directeur Régional + Directeur Commercial Régional&lt;/strong&gt;&lt;/li&gt;&lt;li&gt;&lt;strong&gt;≥ 1M€ &lt;/strong&gt;&lt;strong style=&quot;color: rgb(247, 14, 14); background-color: rgb(255, 255, 255);&quot;&gt;(ou bien Grands Comptes de +240k€ )&lt;/strong&gt;&lt;strong style=&quot;background-color: rgb(255, 255, 255);&quot;&gt; &lt;/strong&gt;&lt;strong&gt;: Directeur de pôle + Directeur Commercial France &lt;/strong&gt;&lt;strong style=&quot;color: rgb(244, 11, 11);&quot;&gt;(Réunion de Comité National)&lt;/strong&gt;&lt;/li&gt;&lt;/ul&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
