    <formulas>
        <name>Inspection4Month</name>
        <dataType>Date</dataType>
        <expression>DATE(YEAR(DATEVALUE({!$Record.Audit_Date_Time__c})), CASE(
    FLOOR((MONTH(DATEVALUE({!$Record.Audit_Date_Time__c})) - 1) / 4) + 1,
    1, 1,  /* Janvier - Avril → Janvier */
    2, 5,  /* Mai - Août → Mai */
    3, 9,  /* Septembre - Décembre → Septembre */
    1  /* Valeur par défaut */
), 1)</expression>
    </formulas>
    <formulas>
        <name>InspectionBimestre</name>
        <dataType>Date</dataType>
        <expression>DATE(YEAR(DATEVALUE({!$Record.Audit_Date_Time__c})), CASE(
    FLOOR((MONTH(DATEVALUE({!$Record.Audit_Date_Time__c})) - 1) / 2) + 1,
    1, 1,  /* Janvier - Février → Janvier */
    2, 3,  /* Mars - Avril → Mars */
    3, 5,  /* Mai - Juin → Mai */
    4, 7,  /* Juillet - Août → Juillet */
    5, 9,  /* Septembre - Octobre → Septembre */
    6, 11, /* Novembre - Décembre → Novembre */
    1  /* Valeur par défaut (normalement inutile) */
), 1)</expression>
    </formulas>
    <formulas>
        <name>InspectionMonth</name>
        <dataType>Date</dataType>
        <expression>DATE(YEAR(DATEVALUE({!$Record.Audit_Date_Time__c})), MONTH(DATEVALUE({!$Record.Audit_Date_Time__c})), 1)</expression>
    </formulas>
    <formulas>
        <name>InspectionQuarter</name>
        <dataType>Date</dataType>
        <expression>DATE(YEAR(DATEVALUE({!$Record.Audit_Date_Time__c})), CASE(
    FLOOR((MONTH(DATEVALUE({!$Record.Audit_Date_Time__c})) - 1) / 3) + 1,
    1, 1,  /* Trimestre 1 → Janvier */
    2, 4,  /* Trimestre 2 → Avril */
    3, 7,  /* Trimestre 3 → Juillet */
    4, 10, /* Trimestre 4 → Octobre */
    1  /* Valeur par défaut (normalement inutile) */
), 1)</expression>
    </formulas>
    <formulas>
        <name>InspectionSemester</name>
        <dataType>Date</dataType>
        <expression>DATE(YEAR(DATEVALUE({!$Record.Audit_Date_Time__c})), CASE(
    FLOOR((MONTH(DATEVALUE({!$Record.Audit_Date_Time__c})) - 1) / 6) + 1,
    1, 1,  /* Semestre 1 → Janvier */
    2, 7,  /* Semestre 2 → Juillet */
    1  /* Valeur par défaut (normalement inutile) */
), 1)</expression>
    </formulas>
    <formulas>
        <name>InspectionYear</name>
        <dataType>Date</dataType>
        <expression>DATE(YEAR(DATEVALUE({!$Record.Audit_Date_Time__c})), 1, 1)</expression>
    </formulas>
