            </conditions>
            <connector>
                <targetReference>Recalcul_Nouveau_Mois</targetReference>
            </connector>
            <label>Date modifiée</label>
        </rules>
        <rules>
            <name>Type_modifi</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.Type__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
