<?xml version="1.0" encoding="UTF-8"?>
<AssignmentRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <assignmentRule>
        <fullName>Global Lead Assignment Rule</fullName>
        <active>true</active>
        <ruleEntry>
            <criteriaItems>
                <field>Lead.DOZISF__ZoomInfo_Company_ID__c</field>
                <operation>notEqual</operation>
            </criteriaItems>
        </ruleEntry>
        <ruleEntry>
            <assignedTo>Nurture_Lead_Queue</assignedTo>
            <assignedToType>Queue</assignedToType>
            <criteriaItems>
                <field>Lead.Status</field>
                <operation>equals</operation>
                <value>Closed - No Current Opportunity</value>
            </criteriaItems>
        </ruleEntry>
        <ruleEntry>
            <assignedTo>Dead_Lead_Queue</assignedTo>
            <assignedToType>Queue</assignedToType>
            <criteriaItems>
                <field>Lead.Status</field>
                <operation>equals</operation>
                <value>Closed - Not Qualified,Closed - Bad Data</value>
            </criteriaItems>
        </ruleEntry>
    </assignmentRule>
</AssignmentRules>
